# Replace placeholders locally.
CAMERA_BACKEND=dvrip
CHANNELS=0,1,3
IP=<camera-host>
PORT=<camera-port>
USER_CAM=<camera-user>
PASSWORD_CAM=<camera-password>
SNAPSHOT_INTERVAL=0.2
IO_TIMEOUT=5
RETRY_INITIAL=1
RETRY_MAX=30
STALE_AFTER=10
WEB_HOST=localhost
WEB_PORT=5000
# With CAMERA_BACKEND=rtsp configure one URL per channel:
# CAMERA_0_RTSP_URL=<stream-url>
# CAMERA_1_RTSP_URL=<stream-url>
# CAMERA_3_RTSP_URL=<stream-url>

# Detection always starts disabled; enable it using the UI button.
ML_MODEL_PATH=models/yolov8n.pt
ML_DEVICE=gpu
ML_FPS=2
ML_IMAGE_SIZE=320
ML_CONFIDENCE=0.4
